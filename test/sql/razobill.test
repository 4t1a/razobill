# name: test/sql/razobill.test
# description: test razobill extension
# group: [razobill]

# Before loading, scalar function should not exist
statement error
SELECT rbForm('User 1042 authenticated');
----
Catalog Error

# Load the extension
require razobill

# Confirm extension decomposition and reconstruction
query T
SELECT rbReconstruct(form, ints, strs) FROM (SELECT (rbDecompose('User 1042 authenticated')).*);
----
User 1042 authenticated

query I
SELECT rbInts('User 1042 authenticated')[1];
----
1042
