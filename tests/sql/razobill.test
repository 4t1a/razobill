# name: tests/sql/razobill.test
# description: test razobill extension
# group: [razobill]

# Before loading, scalar function should not exist
statement error
SELECT RzSplit('User 1042 authenticated');
----
Catalog Error

# Load the extension
require razobill

# Confirm extension decomposition and reconstruction
query T
SELECT RzJoin(template, ints, strs) FROM (SELECT (RzSplit('User 1042 authenticated')).*);
----
User 1042 authenticated

query I
SELECT (RzSplit('User 1042 authenticated')).ints[1];
----
1042
